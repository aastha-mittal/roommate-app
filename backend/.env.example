# Local dev (default): SQLite file next to schema — no Postgres required
DATABASE_URL="file:./dev.db"

# Production (example): PostgreSQL
# DATABASE_URL="postgresql://postgres:postgres@localhost:5432/roommate_match?schema=public"

JWT_SECRET="change-me-in-production-use-long-random-string"
PORT=3001
FRONTEND_URL="http://localhost:5173"

# --- CMU official login (Shibboleth SAML) ---
# 1. Run: cd backend && npm run saml:setup
# 2. Register SP with CMU IT (see docs/CMU_IT_REGISTRATION.md)
CMU_SAML_ENABLED=true
CMU_SAML_ENTITY_ID="http://localhost:3001/shibboleth"
CMU_SAML_CALLBACK_URL="http://localhost:3001/api/auth/cmu/callback"
# PEM files (auto-loaded if present): certs/sp-key.pem, certs/sp-cert.pem, certs/cmu-idp.pem
# Or inline: CMU_SAML_PRIVATE_KEY / CMU_SAML_PUBLIC_CERT / CMU_SAML_IDP_CERT

# --- Local dev only: password login for seeded users (alice@cmu.edu / password123) ---
AUTH_DEV_PASSWORD=true
